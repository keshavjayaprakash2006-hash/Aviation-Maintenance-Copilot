# Aviation Maintenance Copilot - Local Configuration
# Runs 100% locally on localhost using Ollama (No cloud API keys or external accounts required)

# Local Ollama Server URL (default is http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Primary local LLM model (e.g., mistral:latest, qwen2.5:3b, llama3.2, etc.)
OLLAMA_MODEL=mistral:latest

# Embedding model for FAISS dense semantic vector search
OLLAMA_EMBED_MODEL=nomic-embed-text
